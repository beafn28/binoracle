<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.binoracle.daily-scout</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/beatrizfresnonaumova/Desktop/binoracle/scripts/daily_scout.py</string>
        <string>--days</string>
        <string>2</string>
        <string>--min-cvss</string>
        <string>6.0</string>
        <string>--max-per-tech</string>
        <string>10</string>
    </array>

    <!-- Run at 07:17 local time every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/beatrizfresnonaumova/.binoracle/scout_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/beatrizfresnonaumova/.binoracle/scout_launchd.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/beatrizfresnonaumova/Desktop/binoracle</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/beatrizfresnonaumova/Desktop/binoracle</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
